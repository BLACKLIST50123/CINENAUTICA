-- 1. Actualizar funciones del día inicial ("Hoy") hacia el 18 de octubre de 2026
UPDATE funcion
SET fecha = '2026-10-18'
WHERE fecha IN ('2026-10-15', '2026-10-13');

-- 2. Actualizar funciones del segundo día ("Mañana") hacia el 19 de octubre de 2026
